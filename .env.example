# ---- Copy this file to ".env" and fill in real values ----
# .env must NEVER be committed to git or uploaded anywhere public.

# Choose where data comes from:
#   memory = prototype, no database needed (default)
#   pdo    = real MySQL database
REPOSITORY_DRIVER=pdo

# The API bearer token (make it long and random)
API_BEARER_TOKEN=replace_with_a_long_random_api_token

# Use a separate credential for browser result lookups.
RESULTS_VIEW_TOKEN=

# Only needed when REPOSITORY_DRIVER=pdo
DB_HOST=localhost
DB_NAME=results_db
DB_USER=root
DB_PASS=
